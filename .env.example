# ============================================================
# AI Compliance Suite — Environment Variables Template
# ============================================================
#
# Vor dem Start: Kopiere zu .env und passe Werte an
#   cp .env.example .env
#

# ---- AUTH (Pflicht) ----
# JWT-Secret muss mindestens 32 Zeichen sein. Generieren mit:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Token-Lebensdauer in Stunden (default: 24)
JWT_EXPIRES_HOURS=24

# ---- PASSKEY / WEBAUTHN / FIDO2 (Sprint ε) ----
# EMPFEHLUNG: Diese Werte werden bevorzugt über die Weboberfläche gepflegt
#   (Admin → Einstellungen → "Passkey / WebAuthn"). Die ENV-Variablen unten
#   dienen nur noch als Fallback/Bootstrap, falls noch nichts über Web gesetzt
#   wurde. Web-Einstellung hat IMMER Vorrang vor ENV.
# WICHTIG: RP-ID und Origin MÜSSEN zur ausliefernden Domain passen, sonst
# verweigert der Browser die Passkey-Nutzung stillschweigend.
#   - RP_ID  = registrierbare Domain OHNE Schema/Port (z.B. 'localhost' oder 'aics.example.com'; KEINE IP)
#   - ORIGIN = vollständige(r) Origin(s) MIT Schema+Port (komma-separiert erlaubt)
# Hinter Nginx (TLS-Termination): ORIGIN = öffentliche https-Adresse, NICHT die interne.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=AI Compliance Suite
WEBAUTHN_RP_ORIGIN=https://localhost:8443

# CORS — komma-separierte Liste erlaubter Origins
# Production: nur die echte Domain eintragen!
CORS_ORIGINS=https://localhost,https://localhost:443

# ---- USER-MANAGEMENT ----
# Legt Demo-Users an (admin@example.com / admin-password, editor@example.com / editor-password). NUR FÜR DEV!
ENABLE_DEMO_USERS=false

# ---- AICS_PORTAL (entfallen mit #1905) ----
# Der SOC-Portal-Modus ist mit dem SOC-Modul entfernt. Die Variable wird nicht
# mehr gelesen; steht sie in einer Stack-Umgebung noch, wird sie ignoriert.

# ---- HTTPS ----
# Wenn Nginx als Reverse-Proxy läuft: false (Nginx terminiert)
# Standalone Backend: true (Auto-Self-Signed-Cert wird generiert)
HTTPS_ENABLED=false

# ---- GUNICORN ----
GUNICORN_WORKERS=4

# ---- RELEASE-KANAL (#1908) ----
# Der Kanal selbst steht in der Konfiguration (update.channel: stable|beta) und
# ist in den Einstellungen wählbar. `stable` und `beta` kommen BEIDE aus
# aics-public und werden auf ihre Herkunft geprüft; die Beta ist ein
# GitHub-Prerelease, gebaut und signiert wie ein Release.
#
# Der interne Kanal `dev` (unveröffentlichte Stände, main/sha-…) ist bewusst
# NICHT per Klick erreichbar: Er schaltet die Herkunftsprüfung ab und die
# angezeigte Version bezeichnet dann nicht den gebauten Stand. Nur zur
# Nothilfe und nur, wenn hier ausdrücklich freigegeben:
# AICS_UPDATE_CHANNEL_DEV=1

# ---- PDF-KONVERTER (Gotenberg, #1903) ----
# Zeitlimit des Konverter-Dienstes in Sekunden. EINE Zahl für beide Seiten:
# docker-compose setzt daraus `--api-timeout` am Container und gibt sie dem
# Webdienst mit, dessen Client-Limit darüber liegen muss. NICHT den Schalter
# `--api-timeout` von Hand ändern — gibt der Client zuerst auf, bleibt ein
# LibreOffice-Prozess zurück, und danach scheitert JEDE weitere Umwandlung der
# Installation. Der Zustand ist unter Administration → Einstellungen →
# PDF-Konverter ablesbar.
GOTENBERG_API_TIMEOUT_S=120

# ---- LDAP/AD (optional, Issue #270) ----
LDAP_ENABLED=false
LDAP_SERVER=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# JSON-Mapping LDAP-Group → Application-Role
LDAP_GROUP_MAPPING={}

# ---- AI/LLM (optional) ----
# Cloud-Provider API-Key (OpenAI, Anthropic, ...)
AI_CLOUD_API_KEY=

# ---- VCS Integration ----
# GitHub: gh-CLI muss separat authentifiziert sein
# GitLab Token (für Issue-Creation/Sync)
GITLAB_TOKEN=
